{
  "name": "grassed",
  "version": "0.1.1",
  "description": "Grassed, an unofficial Minecraft launcher",
  "author": "Mobinhrr",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.grassed.launcher",
    "productName": "Grassed",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    }
  }
}